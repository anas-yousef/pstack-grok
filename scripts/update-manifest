#!/usr/bin/env python3
"""Rehash pstack-source.json, list new local files, and drop deleted ones.

A vendored file whose bytes changed must have a localPatches entry. Pass
`--patch <file> <reason>` to record one. Without it the script refuses.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ROOT / "pstack-source.json"
TRACKED = (".cursor", "scripts", ".github")
SKIP_PARTS = {"__pycache__", "node_modules"}
ROOT_FILES = ("NOTICE",)


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def tracked_files(root: Path) -> list[str]:
    found = [name for name in ROOT_FILES if (root / name).is_file()]
    for folder in TRACKED:
        for path in (root / folder).rglob("*"):
            if not path.is_file() or SKIP_PARTS.intersection(path.parts):
                continue
            found.append(path.relative_to(root).as_posix())
    return sorted(found)


def update(root: Path, data: dict, patches: dict[str, str]) -> tuple[list[str], list[str]]:
    notes = []
    refused = []
    by_file = {item["file"]: item for item in data["files"]}
    patched = {item["file"] for item in data["localPatches"]}
    on_disk = set(tracked_files(root))
    for rel in sorted(set(by_file) - on_disk):
        notes.append(f"dropped {rel}")
        del by_file[rel]
        data["localPatches"] = [p for p in data["localPatches"] if p["file"] != rel]
    for rel in sorted(on_disk):
        item = by_file.get(rel)
        if item is None:
            by_file[rel] = {"file": rel, "sha256": digest(root / rel), "source": "local", "upstreamPath": None}
            notes.append(f"added {rel}")
            continue
        new = digest(root / rel)
        if new == item["sha256"]:
            continue
        if item["source"] != "local" and rel not in patched:
            if rel not in patches:
                refused.append(rel)
                continue
            data["localPatches"].append(
                {
                    "file": rel,
                    "source": item["source"],
                    "upstreamPath": item["upstreamPath"],
                    "reason": patches[rel],
                }
            )
            patched.add(rel)
        item["sha256"] = new
        notes.append(f"rehashed {rel}")
    data["files"] = [by_file[rel] for rel in sorted(by_file)]
    return notes, refused


def rehash_allowlist(root: Path) -> list[str]:
    path = root / "scripts" / "grok-allowlist.txt"
    rows = []
    notes = []
    for raw in path.read_text(encoding="utf-8").splitlines():
        parts = raw.split()
        if len(parts) == 2 and not raw.startswith("#"):
            new = digest(root / parts[0])
            if new != parts[1]:
                notes.append(f"allowlist rehashed {parts[0]}")
            raw = f"{parts[0]} {new}"
        rows.append(raw)
    path.write_text("\n".join(rows) + "\n", encoding="utf-8")
    return notes


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--patch", nargs=2, action="append", default=[], metavar=("FILE", "REASON"))
    parser.add_argument("--check", action="store_true", help="exit 1 if the manifest is out of date")
    parser.add_argument(
        "--rehash-allowlist",
        action="store_true",
        help="also rehash scripts/grok-allowlist.txt. Read the diff of every listed file first.",
    )
    args = parser.parse_args()
    if args.rehash_allowlist and not args.check:
        for line in rehash_allowlist(ROOT):
            print(line)
    data = json.loads(MANIFEST.read_text(encoding="utf-8"))
    notes, refused = update(ROOT, data, dict(args.patch))
    for line in notes:
        print(line)
    if refused:
        for rel in refused:
            print(f"refused {rel}: vendored file changed with no localPatches entry. Pass --patch {rel} '<reason>'.")
        return 1
    if args.check:
        return 1 if notes else 0
    MANIFEST.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
    print(f"manifest: {len(data['files'])} files, {len(data['localPatches'])} local patches")
    return 0


if __name__ == "__main__":
    sys.exit(main())
