#!/usr/bin/env python3
"""Fail when anything this fork controls names or selects a non-Grok model.

Three checks. A denylist scan for non-Grok model names and cross-family review
text. A parser that requires every value in the model rule, and every agent
`model:` line, to be a Grok slug or `blocked`. And a consistency check on the
computerUse exception record.

In this repo the scan covers the whole tree. In a project that installed the
fork, the scripts live in `scripts/pstack-grok/` and the scan covers only the
files `installed.json` lists, so the project's own code is never scanned.
"""

from __future__ import annotations

import hashlib
import json
import os
import re
import sys
import tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
INSTALL_DIR = "pstack-grok"
RULE = Path(".cursor/rules/pstack-models.mdc")
AGENTS = Path(".cursor/agents")
GROK_SLUG = re.compile(r"^grok-[a-z0-9][a-z0-9.-]*$")
ALIASES = {"inherit-parent", "auto", "unpinned"}
EXCEPTION_STATUSES = {"allowed-exception", "blocked"}
DISPATCHED_SLUG = re.compile(r"^[a-z][a-z0-9]*(-[a-z0-9.]+)+$")
PLACEHOLDERS = {"other", "unknown", "unpinned", "n/a", "none", "tbd", "todo", "auto"}


def _word(text: str) -> str:
    return r"\b" + text + r"\b"


def pattern_list() -> list[re.Pattern[str]]:
    # Pieces stay split so this file does not contain the text it forbids.
    names = ["op" + "us", "son" + "net", "hai" + "ku", "fab" + "le"]
    slug = "cl" + "aude-(" + "|".join(names) + r"|[0-9])"
    others = ["ki" + "mi", "deep" + "seek", "lla" + "ma", "mis" + "tral", "qw" + "en"]
    extra = [
        "gp" + "t-",
        _word("gemi" + "ni"),
        "compo" + "ser-",
        _word("o[1-4](-mini|-pro)?"),
        r"\b(anth" + "ropic|open" + r"ai)\b(?!\.yaml)",
        "differ" + "ent famil",
        "differ" + "ent model famil",
        "a differ" + "ent model",
        "differ" + "ent models",
        "model diver" + "sity",
        "cross" + "-model",
        "multi" + "-model",
        "two or more mod" + "els",
        "model perspec" + "tives",
    ]
    compiled = [re.compile(slug, re.I)]
    compiled.extend(re.compile(_word(name), re.I) for name in names + others)
    compiled.extend(re.compile(item, re.I) for item in extra)
    return compiled


PATTERNS = pattern_list()
PRODUCT = re.compile(re.escape("Cl" + "aude Code"), re.I)

SKIP_DIRS = {".git", "uploads", ".cache", "node_modules", "__pycache__"}
SKIP_SUFFIXES = {".png", ".jpg", ".jpeg", ".gif", ".webp"}


def tool_dir() -> Path:
    return HERE


def installed() -> bool:
    return tool_dir().name == INSTALL_DIR


def repo_root() -> Path:
    return tool_dir().parent.parent if installed() else tool_dir().parent


def install_record(tools: Path) -> dict | None:
    path = tools / "installed.json"
    if not path.is_file():
        return None
    return json.loads(path.read_text(encoding="utf-8"))


def allowlist(tools: Path) -> dict[Path, str]:
    path = tools / "grok-allowlist.txt"
    allowed = {}
    if not path.exists():
        return allowed
    for number, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split()
        if len(parts) != 2 or len(parts[1]) != 64:
            raise SystemExit(f"allowlist row {number} needs a path and a sha256")
        allowed[Path(parts[0])] = parts[1]
    return allowed


def scan_text(text: str) -> list[tuple[int, str, str]]:
    hits = []
    for number, line in enumerate(text.splitlines(), 1):
        visible = PRODUCT.sub(" ", line)
        for pattern in PATTERNS:
            if pattern.search(visible):
                hits.append((number, pattern.pattern, line.strip()))
                break
    return hits


def candidates(root: Path, only: list[str] | None):
    if only is not None:
        for rel in sorted(only):
            path = root / rel
            if path.is_file():
                yield Path(rel), path
        return
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        rel = path.relative_to(root)
        if any(part in SKIP_DIRS for part in rel.parts):
            continue
        yield rel, path


def scan_tree(
    root: Path, tools: Path | None = None, only: list[str] | None = None
) -> tuple[list[str], list[str], list[str]]:
    permits = allowlist(tools or root / "scripts")
    seen = set()
    hits = []
    stale = []
    for rel, path in candidates(root, only):
        if path.suffix.lower() in SKIP_SUFFIXES:
            continue
        seen.add(rel)
        try:
            blob = path.read_bytes()
        except OSError:
            continue
        expected = permits.get(rel)
        if expected is not None and hashlib.sha256(blob).hexdigest() == expected:
            continue
        if expected is not None:
            stale.append(rel.as_posix())
        try:
            text = blob.decode("utf-8")
        except UnicodeDecodeError:
            continue
        for number, pattern, line in scan_text(text):
            hits.append(f"{rel.as_posix()}:{number}: {pattern}: {line[:180]}")
    absent = [rel.as_posix() for rel in sorted(permits) if rel not in seen]
    return hits, stale, absent


def rule_lines(text: str) -> list[tuple[int, str, list[str]]]:
    body = text
    if text.startswith("---"):
        parts = text.split("---", 2)
        body = parts[2] if len(parts) == 3 else ""
        offset = text[: len(text) - len(body)].count("\n")
    else:
        offset = 0
    rows = []
    for number, raw in enumerate(body.splitlines(), offset + 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        role, sep, value = line.rpartition(":")
        if not sep:
            rows.append((number, line, []))
            continue
        rows.append((number, role.strip(), [item.strip() for item in value.split(",")]))
    return rows


def rule_problems(text: str, label: str, aliases_ok: bool) -> tuple[list[str], list[str]]:
    problems = []
    notes = []
    roles = {}
    for number, role, values in rule_lines(text):
        if not values or not role:
            problems.append(f"{label}:{number}: not a `role: value` line")
            continue
        roles[role] = values
        for value in values:
            if GROK_SLUG.match(value) or value == "blocked":
                continue
            if aliases_ok and value in ALIASES:
                notes.append(f"{label}:{number}: {role} is `{value}`, so it runs on the parent chat model")
                continue
            problems.append(f"{label}:{number}: {role}: `{value}` is not a grok-* slug or `blocked`")
    if roles.get("computerUse") not in (None, ["blocked"]):
        problems.append(f"{label}: computerUse must be `blocked`")
    return problems, notes


def agent_problems(root: Path, only: list[str] | None) -> list[str]:
    problems = []
    folder = root / AGENTS
    if only is not None:
        paths = [root / rel for rel in only if Path(rel).parent == AGENTS and rel.endswith(".md")]
    else:
        paths = sorted(folder.glob("*.md")) if folder.is_dir() else []
    for path in paths:
        if not path.is_file():
            continue
        rel = path.relative_to(root).as_posix()
        text = path.read_text(encoding="utf-8")
        front = text.split("---", 2)[1] if text.startswith("---") else ""
        found = re.findall(r"^model:\s*(\S+)\s*$", front, re.M)
        if not found:
            problems.append(f"{rel}: no `model:` line. Pin a grok-* slug.")
        for value in found:
            if not GROK_SLUG.match(value):
                problems.append(f"{rel}: model `{value}` is not a grok-* slug")
    return problems


def yaml_model_problems(root: Path, only: list[str] | None) -> list[str]:
    """Every value inside a top-level `models:` block of a .cursor YAML file must be a grok-* slug."""
    problems = []
    if only is not None:
        paths = [root / rel for rel in only if rel.startswith(".cursor/") and rel.endswith((".yaml", ".yml"))]
    else:
        paths = sorted((root / ".cursor").rglob("*.y*ml")) if (root / ".cursor").is_dir() else []
    for path in paths:
        if not path.is_file() or "node_modules" in path.parts:
            continue
        inside = False
        for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), 1):
            if re.match(r"^models:\s*$", line):
                inside = True
                continue
            if inside and line and not line[0].isspace() and not line.startswith("#"):
                inside = False
            match = re.match(r"^\s+[\w-]+:\s*[\"']?([^\"'#\s]+)", line) if inside else None
            if match and not GROK_SLUG.match(match.group(1)):
                rel = path.relative_to(root).as_posix()
                problems.append(f"{rel}:{number}: model `{match.group(1)}` is not a grok-* slug")
    return problems


def home_rule_path() -> Path:
    override = os.environ.get("PSTACK_HOME_RULE")
    if override is not None:
        return Path(override)
    return Path.home() / ".cursor" / "rules" / "pstack-models.mdc"


def home_problems(project_text: str | None) -> tuple[list[str], list[str]]:
    path = home_rule_path()
    if not path.is_file():
        return [], []
    text = path.read_text(encoding="utf-8")
    problems, notes = rule_problems(text, str(path), aliases_ok=True)
    if project_text is not None:
        project = {role: values for _n, role, values in rule_lines(project_text)}
        for _n, role, values in rule_lines(text):
            if role in project and project[role] != values:
                notes.append(
                    f"{path}: {role} is {', '.join(values)} here and {', '.join(project[role])} in {RULE}. "
                    "Both rules load. Delete the home line to use the project value."
                )
    return problems, notes


def exception_problems(item: dict) -> list[str]:
    problems = []
    required = (
        "status",
        "scope",
        "requested",
        "dispatched",
        "honored",
        "observedIdentity",
        "hookFiresInCloud",
        "billing",
        "logging",
        "probes",
        "evidence",
        "route",
    )
    for key in required:
        if key not in item:
            problems.append(f"missing {key}")
    if problems:
        return problems
    if item["status"] not in EXCEPTION_STATUSES:
        problems.append(f"status {item['status']!r} is not one of {sorted(EXCEPTION_STATUSES)}")
    if not GROK_SLUG.match(str(item["requested"])):
        problems.append("requested is not a grok-* slug")
    if item["honored"] != (item["requested"] == item["dispatched"]):
        problems.append("honored does not match requested == dispatched")
    if item["status"] == "blocked" and not item["hookFiresInCloud"]:
        problems.append("status says blocked, but the record says the hook does not fire in cloud agents")
    if item["status"] == "allowed-exception" and item["honored"]:
        problems.append("an honored Grok request is not an exception")
    dispatched = str(item["dispatched"])
    identity = str(item["observedIdentity"]).strip()
    evidence = str(item["evidence"])
    if not DISPATCHED_SLUG.match(dispatched) or not scan_text(dispatched):
        problems.append(
            f"dispatched {dispatched!r} is not a model slug this check recognizes as non-Grok. "
            "Record the exact slug from the probe's Task arguments."
        )
    if not identity or identity.lower() in PLACEHOLDERS or not scan_text(identity):
        problems.append(f"observedIdentity {identity!r} does not name a recognized non-Grok model")
    if dispatched not in evidence or identity not in evidence:
        problems.append("evidence must quote both the dispatched slug and the observed identity")
    probes = item["probes"]
    if isinstance(probes, bool) or not isinstance(probes, int) or probes < 1:
        problems.append("probes must be the number of probes that showed the swap, at least 1")
    return problems


def report_exceptions(tools: Path) -> int:
    path = tools / "grok-exceptions.json"
    print("computerUse record:")
    if not path.exists():
        print("  missing grok-exceptions.json")
        return 1
    try:
        item = json.loads(path.read_text(encoding="utf-8"))["computerUse"]
    except (json.JSONDecodeError, KeyError, TypeError) as error:
        print(f"  unreadable: {error}")
        return 1
    for key in ("status", "scope", "requested", "dispatched", "honored", "hookFiresInCloud", "billing", "route"):
        if key in item:
            print(f"  {key}: {item[key]}")
    problems = exception_problems(item)
    for problem in problems:
        print(f"  inconsistent: {problem}")
    return 1 if problems else 0


def sample_record(**changes) -> dict:
    slug = "gp" + "t-4o"
    record = {
        "status": "allowed-exception",
        "scope": "cloud agents",
        "requested": "grok-4.7-xhigh",
        "dispatched": slug,
        "honored": False,
        "observedIdentity": "GP" + "T-4o",
        "probes": 1,
        "hookFiresInCloud": False,
        "billing": "paid",
        "logging": "decisions.tsv",
        "evidence": f"Task arguments used {slug}. The reply quoted GP" + "T-4o.",
        "route": "control-ui",
    }
    record.update(changes)
    return record


def self_test() -> int:
    product = "Cl" + "aude Code"
    banned = "son" + "net"
    failures = []
    if scan_text(product + " column"):
        failures.append("product name was flagged")
    if not scan_text(product + " " + banned):
        failures.append("model id beside the product name was missed")
    for text in ("cl" + "aude-op" + "us-5", "a cross" + "-model review", "multi" + "-model", "deep" + "seek-v3", "use o" + "3"):
        if not scan_text(text):
            failures.append(f"missed {text!r}")
    if scan_text("agents/open" + "ai.yaml"):
        failures.append("flagged a vendored file name")
    good = "---\nalwaysApply: true\n---\n# c\nfeature: grok-4.7-xhigh-fast\npanel: grok-4.7-xhigh, grok-4.7-xhigh-fast\ncomputerUse: blocked\n"
    if rule_problems(good, "good", False)[0]:
        failures.append(f"good rule failed {rule_problems(good, 'good', False)}")
    for bad in ("fast", "auto", "cl" + "aude-4.5-" + banned, "grok", "grok-4.7-xhigh, " + "ki" + "mi-k2"):
        problems, _notes = rule_problems(f"role: {bad}\n", "bad", False)
        if not problems:
            failures.append(f"rule value {bad!r} passed")
    if rule_problems("role: auto\n", "home", True)[0]:
        failures.append("home rule alias failed")
    if not rule_problems("computerUse: grok-4.7-xhigh\n", "cu", False)[0]:
        failures.append("computerUse slug passed")
    if exception_problems(sample_record()):
        failures.append(f"good record failed {exception_problems(sample_record())}")
    for bad in (
        sample_record(status="blocked"),
        sample_record(honored=True),
        sample_record(dispatched="grok-4.7-xhigh"),
        sample_record(requested="other"),
        sample_record(dispatched="other"),
        sample_record(dispatched="anything at all"),
        sample_record(dispatched="vendor-model-1"),
        sample_record(observedIdentity=""),
        sample_record(observedIdentity="Vendor Model 1"),
        sample_record(evidence="a probe ran"),
        sample_record(probes=0),
        sample_record(probes=True),
        {"status": "allowed-exception"},
    ):
        if not exception_problems(bad):
            failures.append(f"bad record passed {bad}")
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        (root / "scripts").mkdir()
        quoted = root / "docs"
        quoted.mkdir()
        body = banned + " stays quoted\n"
        target = quoted / "design.md"
        target.write_text(body)
        digest = hashlib.sha256(target.read_bytes()).hexdigest()
        (root / "scripts" / "grok-allowlist.txt").write_text(f"docs/design.md {digest}\n")
        hits, stale, _absent = scan_tree(root)
        if hits or stale:
            failures.append(f"matching hash was scanned {hits} {stale}")
        target.write_text(body + "edited\n")
        hits, stale, _absent = scan_tree(root)
        if not stale or not hits:
            failures.append(f"edited allowlisted file was skipped {hits} {stale}")
        hits, _stale, _absent = scan_tree(root, only=["scripts/grok-allowlist.txt"])
        if hits:
            failures.append(f"scoped scan read an unlisted file {hits}")
        target.unlink()
        report = run_checks(root, root / "scripts", None)
        if report["exit"] == 0 or report["absent"] != ["docs/design.md"]:
            failures.append(f"an absent allowlist path passed {report['absent']}")
        target.write_text(body)
        agents = root / AGENTS
        agents.mkdir(parents=True)
        (agents / "a.md").write_text("---\nname: a\nmodel: fast\n---\n")
        (agents / "b.md").write_text("---\nname: b\n---\n")
        (agents / "c.md").write_text("---\nname: c\nmodel: grok-4.7-xhigh\n---\n")
        found = agent_problems(root, None)
        if len(found) != 2:
            failures.append(f"agent check {found}")
        bot = root / ".cursor" / "bot.yaml"
        bot.write_text('models:\n  triage: "grok-4.7-xhigh"\n  code: "choose-a-slug"\nother:\n  x: y\n')
        found = yaml_model_problems(root, None)
        if len(found) != 1 or "choose-a-slug" not in found[0]:
            failures.append(f"yaml model check {found}")
        if report_exceptions(root) == 0:
            failures.append("missing exception record passed")
        (root / "grok-exceptions.json").write_text(json.dumps({"computerUse": sample_record()}))
        if report_exceptions(root) != 0:
            failures.append("exception record failed")
    for failure in failures:
        print(f"self-test: {failure}")
    if failures:
        return 1
    print("self-test: ok")
    return 0


def run_checks(root: Path, tools: Path, only: list[str] | None) -> dict:
    """Every check this script makes. main and check-upstream --json both call it."""
    import io
    from contextlib import redirect_stdout

    buffer = io.StringIO()
    with redirect_stdout(buffer):
        exception_code = report_exceptions(tools)
    problems = []
    rule_path = root / RULE
    rule_text = rule_path.read_text(encoding="utf-8") if rule_path.is_file() else None
    if rule_text is None:
        problems.append(f"missing {RULE}")
    else:
        problems.extend(rule_problems(rule_text, RULE.as_posix(), aliases_ok=False)[0])
    problems.extend(agent_problems(root, only))
    problems.extend(yaml_model_problems(root, only))
    found, notes = home_problems(rule_text)
    problems.extend(found)
    hits, stale, absent = scan_tree(root, tools, only)
    failed = bool(hits or stale or absent or problems or exception_code)
    return {
        "exit": 1 if failed else 0,
        "scope": "installed files" if only is not None else "whole tree",
        "allowlist": {path.as_posix(): digest for path, digest in sorted(allowlist(tools).items())},
        "exception": buffer.getvalue(),
        "modelProblems": problems,
        "notes": notes,
        "hits": hits,
        "stale": stale,
        "absent": absent,
    }


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
        return self_test()
    tools = tool_dir()
    root = repo_root()
    record = install_record(tools) if installed() else None
    if installed() and record is None:
        print(f"missing {tools / 'installed.json'}. Re-run the fork's scripts/install.")
        return 1
    only = sorted(record["files"]) if record else None
    try:
        report = run_checks(root, tools, only)
    except SystemExit as error:
        print(error, file=sys.stderr)
        return 1
    print(f"scope: {report['scope']}")
    print("allowlist:")
    for path, digest in report["allowlist"].items():
        print(f"  {path} {digest}")
    sys.stdout.write(report["exception"])
    for rel in report["absent"]:
        print(f"allowlist absent: {rel}. Remove the row or restore the file.")
    for rel in report["stale"]:
        print(f"allowlist stale: {rel}")
    for note in report["notes"]:
        print(f"note: {note}")
    print(f"model problems: {len(report['modelProblems'])}")
    for problem in report["modelProblems"]:
        print(f"  {problem}")
    print(f"hits: {len(report['hits'])}")
    for hit in report["hits"]:
        print(hit)
    return report["exit"]


if __name__ == "__main__":
    sys.exit(main())
