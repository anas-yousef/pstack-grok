#!/usr/bin/env python3
"""Pipe sample subagentStart payloads into the hook and check the decision."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent.parent if HERE.name == "pstack-grok" else HERE.parent
HOOK = ROOT / ".cursor" / "hooks" / "block-non-grok.py"
NON_GROK = "cl" + "aude-4.5-" + "son" + "net"


def run(raw: str) -> dict:
    result = subprocess.run(
        [sys.executable, str(HOOK)],
        input=raw,
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise SystemExit(f"hook exited {result.returncode}: {result.stderr}")
    try:
        decision = json.loads(result.stdout)
    except json.JSONDecodeError as error:
        raise SystemExit(f"hook stdout was not JSON: {error}: {result.stdout!r}")
    if result.stderr.strip():
        raise SystemExit(f"hook wrote stderr: {result.stderr}")
    return decision


def expect(name: str, raw: str, permission: str, control_ui: bool) -> None:
    decision = run(raw)
    if decision.get("permission") != permission:
        raise SystemExit(f"{name}: permission {decision.get('permission')!r}")
    message = decision.get("user_message", "")
    if control_ui and "control-ui" not in message:
        raise SystemExit(f"{name}: deny message missing control-ui: {message!r}")
    if permission == "allow" and "user_message" in decision:
        raise SystemExit(f"{name}: allow included user_message")
    print(f"  {name}: {permission}")


def payload(**fields: str) -> str:
    return json.dumps(fields)


def main() -> int:
    expect(
        "computerUse non-grok",
        payload(subagent_type="computerUse", subagent_model=NON_GROK, task="open example.com"),
        "deny",
        True,
    )
    expect(
        "browser even on grok",
        payload(subagent_type="browser", subagent_model="grok-4.7-xhigh"),
        "deny",
        True,
    )
    expect(
        "computer-use kebab",
        payload(subagent_type="computer-use", model="grok-4.7-xhigh"),
        "deny",
        True,
    )
    expect(
        "non-grok reviewer",
        payload(subagent_type="generalPurpose", subagent_model=NON_GROK, task="hostile review"),
        "deny",
        True,
    )
    for kind in ("computer_use_agent", "browserAgent", "BrowserUse", "Computer Use Helper", "cursor-browser"):
        expect(
            f"blocked type {kind} on grok",
            payload(subagent_type=kind, subagent_model="grok-4.7-xhigh"),
            "deny",
            True,
        )
    expect(
        "camelCase computerUse type",
        payload(subagentType="computerUse", subagentModel="grok-4.7-xhigh"),
        "deny",
        True,
    )
    expect(
        "camelCase non-grok model",
        payload(subagent_type="explore", subagentModel=NON_GROK, model="grok-4.7-xhigh"),
        "deny",
        True,
    )
    for model in ("grok", "grokfoo", "grok-", "xgrok-4.7-xhigh", "fast", "auto"):
        expect(
            f"model {model!r}",
            payload(subagent_type="explore", subagent_model=model),
            "deny",
            True,
        )
    expect(
        "padded grok model",
        payload(subagent_type="explore", subagent_model=" grok-4.7-xhigh "),
        "allow",
        False,
    )
    expect(
        "grok explore",
        payload(subagent_type="explore", subagent_model="grok-4.7-xhigh"),
        "allow",
        False,
    )
    expect(
        "grok executor",
        payload(subagent_type="generalPurpose", model="grok-4.7-xhigh-fast", task="edit the hook"),
        "allow",
        False,
    )
    expect(
        "mixed models",
        payload(subagent_type="explore", subagent_model="grok-4.7-xhigh", model=NON_GROK),
        "deny",
        True,
    )
    expect(
        "both grok fields",
        payload(subagent_type="explore", subagent_model="grok-4.7-xhigh", model="grok-4.7-xhigh-fast"),
        "allow",
        False,
    )
    expect(
        "empty child model",
        payload(subagent_type="explore", subagent_model="", model="grok-4.7-xhigh"),
        "deny",
        True,
    )
    expect(
        "whitespace child model",
        payload(subagent_type="explore", subagent_model="  ", model="grok-4.7-xhigh"),
        "deny",
        True,
    )
    expect(
        "envelope non-grok when child is empty",
        payload(subagent_type="explore", subagent_model="", model=NON_GROK),
        "deny",
        True,
    )
    expect(
        "nested computerUse",
        json.dumps(
            {
                "tool_name": "Task",
                "model": "grok-4.7-xhigh",
                "tool_input": {"subagent_type": "computerUse", "model": "grok-4.7-xhigh"},
            }
        ),
        "deny",
        True,
    )
    expect(
        "string tool_input computerUse",
        json.dumps(
            {
                "model": "grok-4.7-xhigh",
                "tool_input": json.dumps(
                    {"subagent_type": "computerUse", "model": "grok-4.7-xhigh"}
                ),
            }
        ),
        "deny",
        True,
    )
    expect(
        "deeper tool_input computerUse",
        json.dumps(
            {
                "model": "grok-4.7-xhigh",
                "tool_input": {
                    "model": "grok-4.7-xhigh",
                    "tool_input": {"subagent_type": "computerUse", "model": "grok-4.7-xhigh"},
                },
            }
        ),
        "deny",
        True,
    )
    expect(
        "unspecified model",
        payload(subagent_type="explore", subagent_model="inherit"),
        "deny",
        True,
    )
    expect("malformed computerUse", "computerUse {", "deny", True)
    expect(
        "malformed escaped computerUse",
        '{"subagent_type":"\\u0063omputerUse","model":"grok-4.7-xhigh"',
        "deny",
        True,
    )
    expect("malformed grok", "explore grok-4.7-xhigh {", "deny", True)
    expect("malformed empty", "", "deny", True)
    expect("malformed other", "not-json", "deny", True)
    print("test-subagent-hook: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
