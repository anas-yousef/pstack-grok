#!/usr/bin/env python3
"""Install this fork into a project, driven by pstack-source.json.

Writes the manifest's `.cursor/` files at the same paths, and the checks plus
NOTICE and the manifest under `scripts/pstack-grok/`. Merges the subagentStart
hook into the project's `.cursor/hooks.json` instead of replacing it. Records
every file it wrote in `scripts/pstack-grok/installed.json`.

A project file this fork would overwrite, and that the last install did not
write, is a conflict. So is a file the last install wrote and the project
edited since. On a conflict nothing is written unless `--force` is given. On a
re-install, a file the last install wrote, that this fork no longer ships, and
that the project did not edit, is removed.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
TOOLS = Path("scripts/pstack-grok")
SHIPPED_SCRIPTS = ("check-grok", "check-paths", "test-subagent-hook", "grok-exceptions.json")
HOOKS = Path(".cursor/hooks.json")
RECORD = TOOLS / "installed.json"


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def plan() -> dict[Path, bytes]:
    """Destination path in the project -> bytes to write."""
    manifest = json.loads((ROOT / "pstack-source.json").read_text(encoding="utf-8"))
    files: dict[Path, bytes] = {}
    for item in manifest["files"]:
        rel = Path(item["file"])
        if rel.parts[0] == ".cursor" and rel != HOOKS:
            files[rel] = (ROOT / rel).read_bytes()
    for name in SHIPPED_SCRIPTS:
        files[TOOLS / name] = (ROOT / "scripts" / name).read_bytes()
    files[TOOLS / "NOTICE"] = (ROOT / "NOTICE").read_bytes()
    files[TOOLS / "pstack-source.json"] = (ROOT / "pstack-source.json").read_bytes()
    files[TOOLS / "grok-allowlist.txt"] = allowlist_for(files).encode("utf-8")
    return files


def installed_path(fork_rel: str) -> Path:
    rel = Path(fork_rel)
    if rel.parts[0] == "scripts":
        return TOOLS / rel.name
    return rel


def allowlist_for(files: dict[Path, bytes]) -> str:
    rows = ["# Generated by the fork's scripts/install. Paths are installed paths."]
    source = ROOT / "scripts" / "grok-allowlist.txt"
    for raw in source.read_text(encoding="utf-8").splitlines():
        parts = raw.split()
        if len(parts) != 2 or raw.startswith("#"):
            continue
        dest = installed_path(parts[0])
        if dest in files:
            rows.append(f"{dest.as_posix()} {parts[1]}")
    return "\n".join(rows) + "\n"


def merged_hooks(target: Path) -> bytes:
    ours = json.loads((ROOT / HOOKS).read_text(encoding="utf-8"))
    path = target / HOOKS
    if path.is_file():
        try:
            theirs = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as error:
            raise SystemExit(f"{HOOKS} in the project is not valid JSON ({error}). Fix it, then re-run.")
    else:
        theirs = {"version": ours.get("version", 1), "hooks": {}}
    hooks = theirs.setdefault("hooks", {})
    for event, entries in ours["hooks"].items():
        current = hooks.setdefault(event, [])
        for entry in entries:
            same = [item for item in current if item.get("command") == entry["command"]]
            if not same:
                current.append(dict(entry))
            for item in same:
                # The project's copy of this hook gets every field the fork sets, failClosed included.
                item.update(entry)
    return (json.dumps(theirs, indent=2) + "\n").encode("utf-8")


def previous(target: Path) -> dict[str, str]:
    path = target / RECORD
    if not path.is_file():
        return {}
    return json.loads(path.read_text(encoding="utf-8"))["files"]


def conflicts(target: Path, files: dict[Path, bytes], before: dict[str, str]) -> list[str]:
    found = []
    for rel, data in sorted(files.items()):
        dest = target / rel
        if not dest.is_file():
            continue
        current = sha(dest.read_bytes())
        if current == sha(data):
            continue
        recorded = before.get(rel.as_posix())
        if recorded is None:
            found.append(f"{rel.as_posix()}: the project already has a different file here")
        elif recorded != current:
            found.append(f"{rel.as_posix()}: edited in the project since the last install")
    return found


def prune(target: Path, files: dict[Path, bytes], before: dict[str, str]) -> list[str]:
    notes = []
    for rel_text, recorded in sorted(before.items()):
        rel = Path(rel_text)
        dest = target / rel
        if rel in files or not dest.is_file():
            continue
        if sha(dest.read_bytes()) != recorded:
            notes.append(f"kept {rel_text}: no longer shipped, but edited in the project")
            continue
        dest.unlink()
        notes.append(f"removed {rel_text}: no longer shipped")
        parent = dest.parent
        while parent != target and parent.is_dir() and not any(parent.iterdir()):
            parent.rmdir()
            parent = parent.parent
    return notes


def install(target: Path, force: bool) -> int:
    target = target.resolve()
    if target == ROOT:
        raise SystemExit("refusing to install into this repo")
    if not target.is_dir():
        raise SystemExit(f"target is not a directory: {target}")
    files = plan()
    before = previous(target)
    found = conflicts(target, files, before)
    if found and not force:
        print("conflicts, nothing written:", file=sys.stderr)
        for line in found:
            print(f"  {line}", file=sys.stderr)
        print("Move the project's file aside, or re-run with --force to overwrite.", file=sys.stderr)
        return 1
    hooks = merged_hooks(target)
    for rel, data in files.items():
        dest = target / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(data)
        if rel.parent == TOOLS and rel.name in {"check-grok", "check-paths", "test-subagent-hook"}:
            dest.chmod(0o755)
    (target / HOOKS).write_bytes(hooks)
    for line in prune(target, files, before):
        print(line)
    manifest = json.loads((ROOT / "pstack-source.json").read_text(encoding="utf-8"))
    record = {
        "fork": manifest["fork"],
        "files": {rel.as_posix(): sha(data) for rel, data in sorted(files.items())},
    }
    (target / RECORD).write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
    print(f"installed {len(files)} files into {target}")
    print(f"merged the subagentStart hook into {HOOKS}")
    print(f"check it with: python3 {TOOLS / 'check-grok'} && python3 {TOOLS / 'test-subagent-hook'}")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description="Install the Grok-only pstack fork into a project.")
    parser.add_argument("target", type=Path)
    parser.add_argument("--force", action="store_true", help="overwrite conflicting project files")
    args = parser.parse_args()
    return install(args.target, args.force)


if __name__ == "__main__":
    sys.exit(main())
