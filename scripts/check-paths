#!/usr/bin/env python3

from __future__ import annotations

import json
import re
import sys
import tempfile
from pathlib import Path

SKIP_DIRS = {".git", "uploads", ".cache", "node_modules", "__pycache__"}
TRIGGER_SENTENCE = "This file is the only copy of the trigger " + "list."
TRIGGER_FILE = Path(".cursor/skills/poteto-mode/references/interrogate-triggers.md")
TRIGGER_REFS = (
    Path(".cursor/skills/poteto-mode/SKILL.md"),
    Path(".cursor/skills/poteto-mode/playbooks/greenfield.md"),
)
TRIGGER_LINK = re.compile(r"(?:\.\./)*references/interrogate-triggers\.md")
TS_RULES = (
    Path(".cursor/rules/no-inline-imports.mdc"),
    Path(".cursor/rules/typescript-exhaustive-switch.mdc"),
)


HERE = Path(__file__).resolve().parent
INSTALLED = HERE.name == "pstack-grok"


def repo_root() -> Path:
    return HERE.parent.parent if INSTALLED else HERE.parent


def installed_files(root: Path) -> list[str] | None:
    """In a project that installed the fork, only the files the install wrote are checked."""
    if not INSTALLED or root != repo_root():
        return None
    record = HERE / "installed.json"
    if not record.is_file():
        raise SystemExit(f"missing {record}. Re-run the fork's scripts/install.")
    return sorted(json.loads(record.read_text(encoding="utf-8"))["files"])


def files(root: Path):
    only = installed_files(root)
    if only is not None:
        for rel in only:
            path = root / rel
            if path.is_file():
                yield Path(rel), path
        return
    for path in root.rglob("*"):
        if not path.is_file():
            continue
        rel = path.relative_to(root)
        if any(part in SKIP_DIRS for part in rel.parts):
            continue
        yield rel, path


def read(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8")
    except (UnicodeDecodeError, OSError):
        return None


def trigger_problems(root: Path) -> list[str]:
    problems = []
    holders = []
    for rel, path in files(root):
        text = read(path)
        if text and TRIGGER_SENTENCE in text:
            holders.append(rel.as_posix())
    if sorted(holders) != [TRIGGER_FILE.as_posix()]:
        problems.append(f"trigger list copied or missing: {sorted(holders)}")
    checklist = root / TRIGGER_FILE
    bullets = []
    checklist_text = read(checklist) or ""
    for line in checklist_text.splitlines():
        if line.startswith("- "):
            bullets.append(line)
    if len(bullets) < 10:
        problems.append("trigger checklist is missing bullets")
    for rel in TRIGGER_REFS:
        path = root / rel
        text = read(path)
        if text is None:
            problems.append(f"missing trigger reference: {rel.as_posix()}")
            continue
        matches = list(TRIGGER_LINK.finditer(text))
        if not matches:
            problems.append(f"missing trigger reference: {rel.as_posix()}")
            continue
        for match in matches:
            target = (path.parent / match.group(0)).resolve()
            if target != checklist.resolve():
                problems.append(f"trigger link does not resolve: {rel.as_posix()} -> {match.group(0)}")
    for rel, path in files(root):
        if rel == TRIGGER_FILE or path.suffix.lower() not in {".md", ".mdc"}:
            continue
        text = read(path) or ""
        for bullet in bullets:
            if bullet in text:
                problems.append(f"duplicated trigger bullet in {rel.as_posix()}")
                break
    return problems


def plugin_root(plugin_json: Path) -> Path:
    if plugin_json.parent.name == ".cursor-plugin":
        return plugin_json.parent.parent
    return plugin_json.parent


def relative_strings(value):
    if isinstance(value, dict):
        for item in value.values():
            yield from relative_strings(item)
    elif isinstance(value, list):
        for item in value:
            yield from relative_strings(item)
    elif isinstance(value, str):
        if value.startswith(("http://", "https://", "git@")):
            return
        if value.startswith(("./", "../")) or ("/" in value and " " not in value):
            yield value


def plugin_problems(root: Path) -> list[str]:
    problems = []
    found = False
    for rel, path in files(root):
        if path.name != "plugin.json":
            continue
        found = True
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except json.JSONDecodeError as error:
            problems.append(f"{rel.as_posix()}: invalid json: {error}")
            continue
        base = plugin_root(path)
        for raw in relative_strings(data):
            target = (base / raw).resolve()
            if not target.exists():
                problems.append(f"dangling plugin path: {rel.as_posix()} -> {raw}")
    if not found:
        problems.append("no plugin.json found")
    return problems


def rule_problems(root: Path) -> list[str]:
    problems = []
    for rel in TS_RULES:
        text = read(root / rel)
        if text is None:
            problems.append(f"missing rule: {rel.as_posix()}")
            continue
        if "alwaysApply: true" in text:
            problems.append(f"{rel.as_posix()} is alwaysApply")
        if "alwaysApply: false" not in text:
            problems.append(f"{rel.as_posix()} missing alwaysApply: false")
        front = text.split("---", 2)[1]
        if "globs:" not in front or "ts" not in front:
            problems.append(f"{rel.as_posix()} missing a TypeScript glob")
    return problems


MD_LINK = re.compile(r"\]\(([^)\s]+)\)")


def link_targets(text: str):
    fenced = False
    for number, line in enumerate(text.splitlines(), 1):
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        for match in MD_LINK.finditer(line):
            target = match.group(1).split("#", 1)[0]
            if not target or re.match(r"[a-z][a-z0-9+.-]*:", target) or target.startswith("<"):
                continue
            if "/" not in target and "." not in target:
                continue
            yield number, target


UP_PATH = re.compile(r"`(\.\./[^`\s]+)`")


def link_problems(root: Path) -> list[str]:
    problems = []
    top = root.resolve()
    for rel, path in files(root):
        if path.suffix.lower() not in {".md", ".mdc"}:
            continue
        text = read(path) or ""
        for number, target in link_targets(text):
            if not (path.parent / target).exists():
                problems.append(f"dead link: {rel.as_posix()}:{number} -> {target}")
        for number, line in enumerate(text.splitlines(), 1):
            for match in UP_PATH.finditer(line):
                if "<" in match.group(1):
                    continue
                resolved = (path.parent / match.group(1)).resolve()
                if top != resolved and top not in resolved.parents:
                    problems.append(f"path outside the repo: {rel.as_posix()}:{number} -> {match.group(1)}")
                elif not resolved.exists():
                    problems.append(f"dead path: {rel.as_posix()}:{number} -> {match.group(1)}")
    return problems


PLAYBOOKS = Path(".cursor/skills/poteto-mode/playbooks")
ROUTER = Path(".cursor/skills/poteto-mode/SKILL.md")


def playbook_problems(root: Path) -> list[str]:
    folder = root / PLAYBOOKS
    router = read(root / ROUTER)
    if router is None or not folder.is_dir():
        return [f"missing {ROUTER.as_posix()} or {PLAYBOOKS.as_posix()}"]
    problems = []
    section = router.split("## Playbooks", 1)[-1]
    routed = set(re.findall(r"playbooks/([a-z0-9-]+\.md)", router))
    for title in re.findall(r"^- \*\*(.+?)\.\*\*", section, re.M):
        words = re.sub(r"[^a-z0-9\s-]", "", title.lower()).split()
        routed.add("-".join(words) + ".md")
    for path in sorted(folder.glob("*.md")):
        if path.name not in routed:
            problems.append(f"playbook not routed from {ROUTER.as_posix()}: {path.name}")
    for name in sorted(set(re.findall(r"playbooks/([a-z0-9-]+\.md)", router))):
        if not (folder / name).is_file():
            problems.append(f"router names a missing playbook: {name}")
    return problems


def problems(root: Path) -> list[str]:
    found = []
    found.extend(trigger_problems(root))
    found.extend(plugin_problems(root))
    found.extend(rule_problems(root))
    found.extend(link_problems(root))
    found.extend(playbook_problems(root))
    return found


def self_test() -> int:
    with tempfile.TemporaryDirectory() as tmp:
        root = Path(tmp)
        plugin = root / ".cursor-plugin"
        plugin.mkdir()
        (plugin / "plugin.json").write_text('{"skills": "./skills/"}')
        dangling = plugin_problems(root)
        if not any("dangling" in item for item in dangling):
            print("self-test: dangling path was accepted", dangling)
            return 1
        skills = root / "skills"
        skills.mkdir()
        (skills / "SKILL.md").write_text("ok\n")
        (plugin / "plugin.json").write_text('{"skills": "./skills/"}')
        if plugin_problems(root):
            print("self-test: resolved path failed", plugin_problems(root))
            return 1
        docs = root / ".cursor" / "docs"
        docs.mkdir(parents=True)
        (docs / "a.md").write_text("[ok](a.md) [gone](../missing.md)\n```\n[example](./src/x.md)\n```\n[u](url)\n")
        (root / "README.md").write_text("[top](nope.md) see `../../../outside.md`\n")
        (root / "notes").mkdir()
        (root / "notes" / "b.md").write_text("inside: `../.cursor/docs/a.md`, gone: `../summary.md`\n")
        found = link_problems(root)
        if len(found) != 4 or not any("dead path" in item for item in found) or not any("nope.md" in item for item in found) or not any("outside the repo" in item for item in found):
            print("self-test: link check", found)
            return 1
        books = root / PLAYBOOKS
        books.mkdir(parents=True)
        (books / "bug-fix.md").write_text("x\n")
        (books / "orphan.md").write_text("x\n")
        (root / ROUTER).write_text("## Playbooks\n\n- **Bug fix.** x\n- **Gone.** File: `playbooks/gone.md`.\n")
        found = playbook_problems(root)
        if not any("orphan.md" in item for item in found) or not any("gone.md" in item for item in found) or len(found) != 2:
            print("self-test: playbook routing", found)
            return 1
    print("self-test: ok")
    return 0


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] == "--self-test":
        return self_test()
    found = problems(repo_root())
    if found:
        print(f"problems: {len(found)}")
        for item in found:
            print(item)
        return 1
    print("problems: 0")
    return 0


if __name__ == "__main__":
    sys.exit(main())
