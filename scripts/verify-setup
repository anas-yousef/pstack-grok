#!/usr/bin/env python3

from __future__ import annotations

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def run(args: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(args, cwd=cwd or ROOT, capture_output=True, text=True)


def expect(args: list[str], code: int, cwd: Path | None = None, contains: str | None = None) -> None:
    result = run(args, cwd)
    text = result.stdout + result.stderr
    if result.returncode != code or (contains and contains not in text):
        sys.stdout.write(result.stdout)
        sys.stderr.write(result.stderr)
        raise SystemExit(f"{' '.join(args)} exited {result.returncode}, expected {code}")


def manifest_problems() -> list[str]:
    data = json.loads((ROOT / "pstack-source.json").read_text(encoding="utf-8"))
    listed = {item["file"] for item in data["files"]}
    problems = []
    for item in data["files"]:
        path = ROOT / item["file"]
        if not path.is_file():
            problems.append(f"missing {item['file']}")
            continue
        digest = hashlib.sha256(path.read_bytes()).hexdigest()
        if digest != item["sha256"]:
            problems.append(f"hash {item['file']}")
    for folder in (".cursor", "scripts", ".github"):
        for path in (ROOT / folder).rglob("*"):
            if not path.is_file() or {"__pycache__", "node_modules"}.intersection(path.parts):
                continue
            rel = path.relative_to(ROOT).as_posix()
            if rel not in listed:
                problems.append(f"unlisted {rel}")
    if "NOTICE" not in listed:
        problems.append("unlisted NOTICE")
    return problems


TOOLS = "scripts/pstack-grok"


def installed_run(target: Path, name: str) -> subprocess.CompletedProcess:
    env = dict(os.environ, PSTACK_HOME_RULE=str(target / "no-home-rule"))
    return subprocess.run(
        [sys.executable, f"{TOOLS}/{name}"], cwd=target, capture_output=True, text=True, env=env
    )


def install_problems() -> str | None:
    """Install into temp projects and check every promise scripts/install makes."""
    with tempfile.TemporaryDirectory() as tmp:
        target = Path(tmp) / "project"
        own = {
            ".cursor/skills/local-only/SKILL.md": "keep\n",
            "NOTICE": "the project's own notice\n",
            "scripts/install": "the project's own installer\n",
            "scripts/verify-setup": "the project's own check\n",
            "docs/design.md": "op" + "us is a word in this product\n",
            ".venv/lib/vendor.py": "MODEL = 'gp" + "t-4o'\n",
            "src/app.py": "PROVIDER = 'gemi" + "ni'\n",
        }
        for rel, text in own.items():
            (target / rel).parent.mkdir(parents=True, exist_ok=True)
            (target / rel).write_text(text)
        (target / ".cursor" / "hooks.json").write_text(
            json.dumps({"version": 1, "hooks": {"afterFileEdit": [{"command": "./format.sh"}]}})
        )
        first = run(["python3", "scripts/install", str(target)])
        if first.returncode != 0:
            return f"first install failed: {first.stderr}"
        for rel, text in own.items():
            if (target / rel).read_text(encoding="utf-8") != text:
                return f"install changed the project's {rel}"
        hooks = json.loads((target / ".cursor" / "hooks.json").read_text(encoding="utf-8"))["hooks"]
        if hooks.get("afterFileEdit") != [{"command": "./format.sh"}]:
            return f"install dropped the project's own hook: {hooks}"
        starts = hooks.get("subagentStart", [])
        if len(starts) != 1 or not starts[0].get("failClosed"):
            return f"install did not merge one failClosed subagentStart hook: {hooks}"
        required = (
            ".cursor/skills/show-me-your-work/scripts/log.sh",
            ".cursor/skills/deslop/SKILL.md",
            ".cursor/skills/control-ui/SKILL.md",
            ".cursor/skills/control-cli/SKILL.md",
            ".cursor/skills/poteto-mode/references/interrogate-triggers.md",
            ".cursor/rules/pstack-models.mdc",
            ".cursor/hooks/block-non-grok.py",
            f"{TOOLS}/grok-exceptions.json",
            f"{TOOLS}/check-grok",
            f"{TOOLS}/check-paths",
            f"{TOOLS}/test-subagent-hook",
            f"{TOOLS}/NOTICE",
            f"{TOOLS}/installed.json",
        )
        for rel in required:
            if not (target / rel).is_file():
                return f"missing {rel}"
        for rel in (f"{TOOLS}/install", f"{TOOLS}/verify-setup", "pstack-source.json"):
            if (target / rel).exists():
                return f"shipped {rel}, which belongs to the fork repo only"
        allow = (target / TOOLS / "grok-allowlist.txt").read_text(encoding="utf-8")
        if "docs/design.md" in allow:
            return "shipped the fork's docs/design.md allowlist row"
        checks = (("check-grok", "hits: 0"), ("test-subagent-hook", "test-subagent-hook: ok"), ("check-paths", "problems: 0"))
        for name, text in checks:
            result = installed_run(target, name)
            if result.returncode != 0 or text not in result.stdout:
                return f"installed {name} failed in a product repo:\n{result.stdout}{result.stderr}"
        rule = target / ".cursor" / "rules" / "pstack-models.mdc"
        rule.write_text(rule.read_text(encoding="utf-8").replace("bug-fix: grok-4.7-xhigh-fast", "bug-fix: auto"))
        if installed_run(target, "check-grok").returncode == 0:
            return "installed check-grok accepted an alias in the project rule"
        again = run(["python3", "scripts/install", str(target)])
        if again.returncode == 0 or "edited in the project" not in again.stderr:
            return f"re-install overwrote an edited rule: {again.stdout}{again.stderr}"
        record_path = target / TOOLS / "installed.json"
        record = json.loads(record_path.read_text(encoding="utf-8"))
        retired = target / ".cursor" / "skills" / "retired" / "SKILL.md"
        retired.parent.mkdir(parents=True)
        retired.write_text("old\n")
        record["files"][".cursor/skills/retired/SKILL.md"] = hashlib.sha256(b"old\n").hexdigest()
        record_path.write_text(json.dumps(record))
        forced = run(["python3", "scripts/install", "--force", str(target)])
        if forced.returncode != 0 or retired.exists():
            return f"re-install did not prune a retired file: {forced.stdout}{forced.stderr}"
        hooks = json.loads((target / ".cursor" / "hooks.json").read_text(encoding="utf-8"))["hooks"]
        if len(hooks.get("subagentStart", [])) != 1:
            return f"re-install duplicated the subagentStart hook: {hooks}"
        weak = Path(tmp) / "weak-hook"
        (weak / ".cursor").mkdir(parents=True)
        fork_hooks = json.loads((ROOT / ".cursor" / "hooks.json").read_text(encoding="utf-8"))
        hook_command = fork_hooks["hooks"]["subagentStart"][0]["command"]
        weak_entry = {"command": hook_command, "failClosed": False}
        (weak / ".cursor" / "hooks.json").write_text(
            json.dumps({"version": 1, "hooks": {"subagentStart": [weak_entry]}})
        )
        merged = run(["python3", "scripts/install", str(weak)])
        starts = json.loads((weak / ".cursor" / "hooks.json").read_text(encoding="utf-8"))["hooks"]["subagentStart"]
        if merged.returncode != 0 or starts != [{"command": hook_command, "failClosed": True}]:
            return f"install left the existing subagentStart hook without failClosed: {starts}"
        clash = Path(tmp) / "clash"
        theirs = clash / ".cursor" / "skills" / "tdd" / "SKILL.md"
        theirs.parent.mkdir(parents=True)
        theirs.write_text("the project's own tdd\n")
        refused = run(["python3", "scripts/install", str(clash)])
        if refused.returncode == 0 or theirs.read_text(encoding="utf-8") != "the project's own tdd\n":
            return "install overwrote a project skill with the same name"
        if (clash / TOOLS).exists():
            return "install wrote files before reporting a conflict"
    return None


def computer_use_outcome(root: Path) -> list[str]:
    """Check what the hook does and what the record claims, not a status label."""
    problems = []
    hook = root / ".cursor" / "hooks" / "block-non-grok.py"
    record = json.loads((root / "scripts" / "grok-exceptions.json").read_text(encoding="utf-8"))["computerUse"]
    payload = json.dumps({"subagent_type": "computerUse", "subagent_model": record["requested"]})
    result = subprocess.run([sys.executable, str(hook)], input=payload, capture_output=True, text=True)
    decision = json.loads(result.stdout or "{}")
    if decision.get("permission") != "deny":
        problems.append(f"local hook did not deny computerUse on {record['requested']}: {decision}")
    if record["dispatched"].startswith("grok-") or record["honored"]:
        problems.append("record says the platform honored Grok, which contradicts the cloud probes")
    if record["hookFiresInCloud"] and record["status"] != "blocked":
        problems.append("record says the hook fires in cloud agents but still lists an exception")
    if not record["hookFiresInCloud"] and record["status"] != "allowed-exception":
        problems.append("the hook does not fire in cloud agents, so the record must say allowed-exception")
    rule = (root / ".cursor" / "rules" / "pstack-models.mdc").read_text(encoding="utf-8")
    if "computerUse: blocked" not in rule.splitlines():
        problems.append("the model rule no longer keeps computerUse blocked")
    return problems


BUN_DIR = ROOT / ".cursor" / "skills" / "poteto-mode" / "scripts"
SKIP_BUN = "--skip-bun"


def bun_problems(skip: bool) -> str | None:
    """Run every poteto-mode bun test and the typecheck. Missing bun fails unless --skip-bun is given."""
    package = json.loads((BUN_DIR / "package.json").read_text(encoding="utf-8"))
    types = package["devDependencies"]["bun-types"]
    workflow = (ROOT / ".github" / "workflows" / "grok.yml").read_text(encoding="utf-8")
    pinned = re.search(r"bun-version:\s*([0-9.]+)", workflow)
    if not pinned or pinned.group(1) != types:
        return f"CI bun-version {pinned.group(1) if pinned else 'missing'} does not match bun-types {types}"
    if skip:
        print(f"SKIPPED: bun tests and typecheck ({SKIP_BUN}). This run does not prove the poteto-mode scripts.")
        return None
    if not shutil.which("bun"):
        return f"bun is not installed. Install bun {types}, or pass {SKIP_BUN} to skip on purpose."
    local = run(["bun", "--version"]).stdout.strip()
    if local != types:
        print(f"warning: local bun {local} differs from the pinned {types} that CI uses")
    for args in (
        ["bun", "install", "--frozen-lockfile"],
        ["bun", "test"],
        ["bun", "run", "typecheck"],
    ):
        result = run(args, cwd=BUN_DIR)
        text = result.stdout + result.stderr
        if result.returncode != 0 or (args[1] == "test" and " 0 fail" not in text):
            sys.stdout.write(text)
            return f"{' '.join(args)} exited {result.returncode}"
        if args[1] == "test":
            passed = re.search(r"(\d+) pass", text)
            print(f"bun test: {passed.group(1) if passed else '?'} pass, 0 fail")
    return None


def main() -> int:
    skip_bun = SKIP_BUN in sys.argv[1:]
    unknown = [arg for arg in sys.argv[1:] if arg != SKIP_BUN]
    if unknown:
        print(f"usage: scripts/verify-setup [{SKIP_BUN}]", file=sys.stderr)
        return 2
    expect(["python3", "scripts/check-grok", "--self-test"], 0)
    expect(["python3", "scripts/check-grok"], 0, contains="hits: 0")
    hook_problems = computer_use_outcome(ROOT)
    if hook_problems:
        print("computerUse outcome:")
        for item in hook_problems:
            print(f"  {item}")
        return 1
    expect(["python3", "scripts/test-subagent-hook"], 0, contains="test-subagent-hook: ok")
    expect(["python3", "scripts/check-paths", "--self-test"], 0)
    expect(["python3", "scripts/check-paths"], 0, contains="problems: 0")
    expect(["python3", "scripts/check-upstream", "--self-test"], 0)
    bun_failure = bun_problems(skip_bun)
    if bun_failure:
        print(f"bun: {bun_failure}")
        return 1
    problems = manifest_problems()
    if problems:
        print("manifest:")
        for item in problems:
            print(item)
        print("run python3 scripts/update-manifest after reading the diff")
        return 1
    failure = install_problems()
    if failure:
        print(f"install: {failure}")
        return 1
    refused = run(["python3", "scripts/install", str(ROOT)])
    if refused.returncode == 0:
        print("install accepted this repo")
        return 1
    print("verify-setup: ok")
    return 0


if __name__ == "__main__":
    sys.exit(main())
