#!/bin/sh
exec node --input-type=module - "$@" <<'END'
import { spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";

const CATALOG_REPO = "https://github.com/anas-yousef/pstack-grok";
const ADVISORY = `## pstack

\`.cursor/pstack-source.json\` records the catalog repo, commit, and profile. \`scripts/sync-pstack\` copies \`.cursor/\` from that pin. \`scripts/check-pstack\` prints \`ok\` when those copied files match the pin.
`;

try {
	const args = parseArgs(process.argv.slice(2));
	assertRepoRoot();
	const commit = args.commit ?? head(args.repo);
	const tree = fetchTree(args.repo, commit);
	try {
		readProfile(tree, args.profile);
		const syncSrc = path.join(tree, "scripts", "sync-pstack");
		const checkSrc = path.join(tree, "scripts", "check-pstack");
		if (!isFile(syncSrc) || !isFile(checkSrc)) {
			throw new Error("catalog commit has no sync scripts");
		}
		fs.mkdirSync(".cursor", { recursive: true });
		fs.mkdirSync("scripts", { recursive: true });
		fs.writeFileSync(
			".cursor/pstack-source.json",
			`${JSON.stringify({ repo: args.repo, commit, profile: args.profile }, null, 2)}\n`,
		);
		fs.copyFileSync(syncSrc, "scripts/sync-pstack");
		fs.copyFileSync(checkSrc, "scripts/check-pstack");
		fs.chmodSync("scripts/sync-pstack", 0o755);
		fs.chmodSync("scripts/check-pstack", 0o755);
	} finally {
		fs.rmSync(tree, { recursive: true, force: true });
	}
	const sync = spawnSync("node", ["scripts/sync-pstack"], {
		cwd: process.cwd(),
		encoding: "utf8",
		stdio: ["ignore", "pipe", "pipe"],
	});
	process.stdout.write(sync.stdout ?? "");
	process.stderr.write(sync.stderr ?? "");
	if (sync.status !== 0) process.exit(sync.status ?? 2);
	appendAdvisory();
} catch (err) {
	const message = err instanceof Error ? err.message : String(err);
	process.stderr.write(`init: ${message}\n`);
	process.exit(2);
}

function parseArgs(argv) {
	let profile = "grok";
	let commit = null;
	let repo = CATALOG_REPO;
	for (let i = 0; i < argv.length; i++) {
		const flag = argv[i];
		if (flag === "--profile") {
			profile = required(argv, ++i, "--profile");
			continue;
		}
		if (flag === "--commit") {
			commit = required(argv, ++i, "--commit");
			continue;
		}
		if (flag === "--repo") {
			repo = required(argv, ++i, "--repo");
			continue;
		}
		throw new Error("usage: scripts/init [--profile <name>] [--commit <sha>] [--repo <url>]");
	}
	if (!/^[a-z0-9][a-z0-9-]*$/.test(profile)) throw new Error(`bad profile ${JSON.stringify(profile)}`);
	if (commit !== null && !/^[0-9a-f]{40}$/.test(commit)) throw new Error("bad commit");
	assertRepo(repo);
	return { profile, commit, repo };
}

function required(argv, index, flag) {
	const value = argv[index];
	if (value === undefined || value.startsWith("--")) throw new Error(`missing value for ${flag}`);
	return value;
}

function assertRepo(repo) {
	if (typeof repo !== "string" || repo.length === 0 || /[\n\r]/.test(repo)) {
		throw new Error("repo must be an https URL or an absolute path");
	}
	if (path.isAbsolute(repo)) return;
	let url;
	try {
		url = new URL(repo);
	} catch {
		throw new Error(`repo is not an https URL: ${repo}`);
	}
	if (
		url.protocol !== "https:" ||
		url.username !== "" ||
		url.password !== "" ||
		url.search !== "" ||
		url.hash !== ""
	) {
		throw new Error(`repo must be https without userinfo, query, or hash: ${repo}`);
	}
}

function assertRepoRoot() {
	const result = spawnSync("git", ["rev-parse", "--show-toplevel"], {
		cwd: process.cwd(),
		env: gitEnv(),
		encoding: "utf8",
		stdio: ["ignore", "pipe", "pipe"],
	});
	if (result.status !== 0) throw new Error("run inside a git repository");
	if (path.resolve(result.stdout.trim()) !== path.resolve(process.cwd())) {
		throw new Error("run from the repository root");
	}
}

function head(repo) {
	const stdout = git(["ls-remote", "--symref", repo, "HEAD"]);
	const tips = [];
	for (const line of stdout.split("\n")) {
		if (line.length === 0) continue;
		const fields = line.split(/\s+/);
		if (fields[1] === "HEAD" && /^[0-9a-f]{40}$/.test(fields[0])) tips.push(fields[0]);
	}
	if (tips.length !== 1) throw new Error(`expected one HEAD from the catalog, saw ${tips.length}`);
	return tips[0];
}

function isFile(file) {
	try {
		return fs.statSync(file).isFile();
	} catch (err) {
		if (err && err.code === "ENOENT") return false;
		throw err;
	}
}

function readProfile(tree, name) {
	const rel = name === "grok" ? path.join(".cursor", "rules", "pstack-models.mdc") : path.join("profiles", `${name}.mdc`);
	let text;
	try {
		text = fs.readFileSync(path.join(tree, rel), "utf8");
	} catch (err) {
		if (err && err.code === "ENOENT") throw new Error(`unknown profile ${name}`);
		throw err;
	}
	const match = text.match(/^# profile: ([a-z0-9][a-z0-9-]*)/m);
	if (!match || match[1] !== name) throw new Error(`profile ${name} does not match its file`);
}

function fetchTree(repo, commit) {
	const dest = fs.mkdtempSync(path.join(os.tmpdir(), "pstack-init-"));
	try {
		git(["init", "-q", "-b", "main", dest]);
		git(["-C", dest, "fetch", "--depth=1", repo, commit]);
		git(["-C", dest, "checkout", "-q", "--detach", "FETCH_HEAD"]);
		return dest;
	} catch (err) {
		fs.rmSync(dest, { recursive: true, force: true });
		throw err;
	}
}

function git(args) {
	const result = spawnSync("git", args, {
		env: gitEnv(),
		encoding: "utf8",
		maxBuffer: 16 * 1024 * 1024,
		stdio: ["ignore", "pipe", "pipe"],
	});
	if (result.error) throw new Error(result.error.message);
	if (result.status !== 0) {
		const stderr = result.stderr ? result.stderr.trim() : "";
		throw new Error(stderr || `git exited ${result.status ?? result.signal}`);
	}
	return result.stdout;
}

function gitEnv() {
	const env = { ...process.env };
	delete env.GIT_DIR;
	delete env.GIT_WORK_TREE;
	env.GIT_CONFIG_GLOBAL = "/dev/null";
	env.GIT_CONFIG_NOSYSTEM = "1";
	env.GIT_CONFIG_COUNT = "0";
	env.GIT_TERMINAL_PROMPT = "0";
	return env;
}

function appendAdvisory() {
	const marker = "## pstack";
	if (!fs.existsSync("AGENTS.md")) {
		fs.writeFileSync("AGENTS.md", `${ADVISORY}\n`);
		return;
	}
	const text = fs.readFileSync("AGENTS.md", "utf8");
	if (text.split("\n").includes(marker)) return;
	const sep = text.endsWith("\n") ? "\n" : "\n\n";
	fs.appendFileSync("AGENTS.md", `${sep}${ADVISORY}\n`);
}
END
